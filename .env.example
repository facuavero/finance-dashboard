# url pública de la app (se usa para links de recuperación y el callback de oauth)
APP_URL=http://localhost:3000

# base de datos. vacío = pglite local en .data/pglite (postgres embebido, sin instalar nada)
# en producción: postgres://usuario:clave@host:5432/caudal
DATABASE_URL=

# clave para cifrar tokens de oauth (32 bytes en base64). generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ia gratuita. alcanza con una. sin ninguna, la app usa el motor de reglas local.
# gemini: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# groq: https://console.groq.com/keys (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# google oauth para gmail y calendar (console.cloud.google.com > credenciales > id de cliente oauth web)
# redirect uri autorizada: {APP_URL}/api/integrations/google/callback
# sin esto, integraciones funciona en modo demo con datos de ejemplo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# envío de emails de recuperación (opcional). sin esto, en desarrollo el link se muestra en consola
RESEND_API_KEY=
EMAIL_FROM=Caudal <no-reply@tu-dominio.com>

# muestra el botón "entrar con cuenta demo" en el login
DEMO_MODE=true
